{
  "name": "l3a-random-generator-app",
  "version": "1.0.0",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "test": "jest --runInBand",
    "test:watch": "jest --watch"
  },
  "author": "Nawid",
  "license": "MIT",
  "build": {
    "appId": "com.randomgenerator.app",
    "productName": "Random Generator",
    "directories": {
      "output": "dist"
    }
  },
  "files": [
    "src/**/*",
    "public/**/*",
    "node_modules/**/*",
    "package.json"
  ],
  "mac": {
    "category": "public.app-category.utilities",
    "target": [
      "dmg",
      "zip"
    ]
  },
  "win": {
    "target": [
      "nsis",
      "portable"
    ]
  },
  "linux": {
    "target": [
      "AppImage",
      "deb"
    ]
  },
  "dependencies": {
    "random--generator": "file:../Random--generator"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  }
}
